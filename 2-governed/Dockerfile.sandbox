# =============================================================================
# Offline-Ready Ubuntu OpenShell Sandbox Image (bounded-boxer-ubuntu:latest)
# Used by Docker Desktop on macOS (Apple Silicon arm64) or when SANDBOX_ENGINE=docker.
# Runs static Go binaries (./bin/bounded-boxer-agent) as non-root 'sandbox' user.
# =============================================================================
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive \
    ADK_DISABLE_TELEMETRY=1 \
    DO_NOT_TRACK=1

RUN apt-get update -qq && apt-get install -y -qq --no-install-recommends \
    ca-certificates \
    curl \
    iproute2 \
    netcat-openbsd \
    && rm -rf /var/lib/apt/lists/*

# Create non-root 'sandbox' user/group matching 2-governed/policy.yaml (process.run_as_user: sandbox)
RUN groupadd -g 10001 sandbox && \
    useradd -u 10001 -g sandbox -m -s /bin/bash sandbox

WORKDIR /app
USER sandbox
